# Colloquy environment configuration.
# Copy this file to `.env` and fill in whichever provider keys you have.
# You do not need any of them — the Mock provider works with zero keys
# and is the recommended path for a first run / classroom dry-run.

# Anthropic (Claude). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (ChatGPT). Get a key at https://platform.openai.com/
OPENAI_API_KEY=

# Google (Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port the Express server listens on.
PORT=3000
